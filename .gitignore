# ============== 原始大文件 (16GB+，永远不上传) ==============
raw-data/

# ============== 离线瓦片下载产物 (按需下载，不上传；随库的 21 个 terrain z0–z3 已跟踪不受影响) ==============
public/tiles/*

# ============== 下载中间产物 ==============
satellite-tiles-*.txt
public-tiles-aria2.txt
tools/all-urls.txt
extracted-layers.json

